{
  // Singleton record holding every editable piece of copy + theme color for
  // the live site. Read is public (anonymous visitors need it to render the
  // page); writes are restricted to admins via /studio.
  "name": "SiteConfig",
  "type": "object",
  "properties": {
    "theme": {
      "type": "object",
      "description": "Hex color overrides, keyed by Tailwind color name (ink, bark, umber, moss, sage, clay, amber, paper, parch, fog, mist). Applied at runtime as --color-* CSS custom properties."
    },
    "hero": {
      "type": "object",
      "description": "Home hero (frame-sequence) overlay text: { eyebrow, title, tagline, scrollHint }."
    },
    "philosophy": {
      "type": "object",
      "description": "Home philosophy statement: { eyebrow, lead, text }."
    },
    "recognition": {
      "type": "object",
      "description": "Home recognition band: { eyebrow, items: string[], award }."
    },
    "arrival": {
      "type": "object",
      "description": "Home 'Arrival' parallax band: { eyebrow, line1, line2 }."
    },
    "contact": {
      "type": "object",
      "description": "Shared contact details used on Home, About, Contact, Footer: { eyebrow, heading, blurb, email, phone, addressLine1, addressLine2 }."
    },
    "footer": {
      "type": "object",
      "description": "Footer copy: { tagline, bottomNote }."
    },
    "backgrounds": {
      "type": "object",
      "description": "Per-section background config, keyed by section id. Each value: { type, color?, image?, overlay?, sequenceId?, scrubVh?, posterImage?, gradientTop?, gradientBottom? }. gradientTop/Bottom: { enabled, color, colorEnd, opacity, opacityEnd, height, overlap }."
    },
    "homeSectionOrder": {
      "type": "array",
      "description": "Ordered list of home page section ids (built-in ids plus custom-* ids)."
    },
    "customSections": {
      "type": "object",
      "description": "Custom home sections keyed by id. Content bands: { id, type: 'content', eyebrow, heading, body }. Playground: { id, type: 'playground', playgroundId, label, config }."
    },
    "textStyles": {
      "type": "object",
      "description": "Per-field typography overrides keyed by dot path (e.g. hero.title, philosophy.text). Each value: { fontId, fontSize, fontSizeUnit, fontWeight, fontStyle, lineHeight, letterSpacing, letterSpacingUnit, color, textAlign, textTransform, textDecoration, opacity }."
    },
    "journeys": {
      "type": "array",
      "description": "Overrides for the four journey cards, matched by slug against src/data/journeys.js. Images and the Entry/Immersion/Emergence arc stay static; only these summary fields are editable.",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "tagline": { "type": "string" },
          "duration": { "type": "string" },
          "location": { "type": "string" },
          "sound": { "type": "string" },
          "intro": { "type": "string" }
        }
      }
    }
  },
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
